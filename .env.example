# ---- LLM provider ----  one of: gemini | groq | nvidia | chutes | openai | openrouter | ollama
LLM_PROVIDER=gemini

# Put the key for the provider you chose (only that one is needed)
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
CHUTES_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Model ids. Run `python main.py models` to list what your key can use.
# Defaults per provider live in rfp_intel/config.py; these are the ones used for the shipped outputs.
LLM_MODEL=gemini-3.5-flash-lite
LLM_SMALL_MODEL=gemma-4-26b-a4b-it

# ---- Embeddings ----  fastembed = local ONNX model (downloaded once, ~130 MB); hash = offline fallback
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Storage ----
INDEX_DIR=./index_store
RUNS_DIR=./runs
OUTPUTS_DIR=./outputs

# ---- Chunking ----
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=250

# ---- Retrieval ----
DEFAULT_TOP_K=8
CANDIDATE_POOL=30
RRF_K=60
RERANK_ENABLED=true
RERANK_CANDIDATES=10
RERANK_CHARS=350
QUERY_REWRITE_LLM=false

# ---- Agents ----
MAX_FIELD_RETRIES=2
# parallel LLM calls; 2 is safe for free tiers, raise to 4-6 on paid tiers
AGENT_CONCURRENCY=2

# ---- OCR (bonus, needs tesseract installed) ----
OCR_ENABLED=false